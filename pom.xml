<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>commons-java</groupId>
    <artifactId>commons-java</artifactId>
    <version>1.0.0</version>

    <name>commons</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>25</java.version>
    </properties>

    <profiles>
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <family>linux</family>
                </os>
            </activation>
            <properties>
                <native.lib.path>
                    ${project.build.directory}/nar/${project.artifactId}-${project.version}-amd64-Linux-gpp-jni/lib/amd64-Linux-gpp/jni
                </native.lib.path>
            </properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <native.lib.path>
                    ${project.build.directory}/nar/${project.artifactId}-${project.version}-amd64-Windows-gpp-jni/lib/amd64-Windows-gpp/jni
                </native.lib.path>
            </properties>
        </profile>
        <profile>
            <id>mac-arm</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.lib.path>
                    ${project.build.directory}/nar/${project.artifactId}-${project.version}-aarch64-MacOSX-gpp-jni/lib/aarch64-MacOSX-gpp/jni
                </native.lib.path>
            </properties>
        </profile>
        <profile>
            <id>mac-x86</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <native.lib.path>
                    ${project.build.directory}/nar/${project.artifactId}-${project.version}-x86_64-MacOSX-gpp-jni/lib/x86_64-MacOSX-gpp/jni
                </native.lib.path>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Optionally: parameterized tests support -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- This plugin builds the agent JAR before tests run -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>commons.java.agent.InjectAgent</Premain-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- This plugin runs the tests and needs to be configured to use the agent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <argLine>
                        -javaagent:${project.basedir}/target/${project.artifactId}-${project.version}.jar
                        -Djava.library.path=${native.lib.path}
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>process-sources</phase>   <!-- ← earlier than compile -->
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>${java.version}</release>
                            <compilerArgs>
                                <!-- Output headers to target/generated-sources/jni so C code can include them -->
                                <arg>-h</arg>
                                <arg>${project.build.directory}/generated-sources/jni</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <version>2.29.0</version>
                <configuration>
                    <configFile>${project.basedir}/.formatter.xml</configFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>format</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>25</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Compile C and produce native lib -->
            <plugin>
                <groupId>com.github.maven-nar</groupId>
                <artifactId>nar-maven-plugin</artifactId>
                <version>3.10.1</version>
                <extensions>true</extensions>
                <executions>
                    <!-- Validate AOL (arch/OS/linker) -->
                    <execution>
                        <id>nar-validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>nar-validate</goal>
                        </goals>
                    </execution>
                    <!-- Download any NAR dependencies -->
                    <execution>
                        <id>nar-download</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>nar-download</goal>
                        </goals>
                    </execution>
                    <!-- Unpack NAR dependencies -->
                    <execution>
                        <id>nar-unpack</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>nar-unpack</goal>
                        </goals>
                    </execution>
                    <!-- Set up system includes -->
                    <execution>
                        <id>nar-system-generate</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>nar-system-generate</goal>
                        </goals>
                    </execution>
                    <!-- Compile the C code -->
                    <execution>
                        <id>nar-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>nar-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <c>
                        <sourceDirectory>src/main/c</sourceDirectory>
                        <includePaths>
                            <includePath>${project.build.directory}/generated-sources/jni</includePath>
                        </includePaths>
                    </c>
                    <java>
                        <include>true</include>
                    </java>
                    <libraries>
                        <library>
                            <type>jni</type>
                        </library>
                    </libraries>
                </configuration>
            </plugin>
            <!-- Copy .so/.dll into jar under natives/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>copy-natives</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/natives</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/nar</directory>
                                    <includes>
                                        <include>**/*.so</include>
                                        <include>**/*.dll</include>
                                        <include>**/*.dylib</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
